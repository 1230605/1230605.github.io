---
import Base from './Base.astro';
interface Props {
  title: string; description: string; kind: 'articles' | 'projects';
  tags: string[]; preview: boolean;
  headings: { depth: number; slug: string; text: string }[];
}
const { title, description, kind, tags, preview, headings } = Astro.props;
---
<Base title={title} description={description} noindex={preview}>
  <article class="detail wrap"><a class="back-link" href={`/${kind}/`}>← {kind === 'articles' ? '所有文章 / Writing' : '所有项目 / Projects'}</a>
    <header class="detail-header">{preview && <p class="preview-banner">预览内容 · 仅用于展示模板，不会发布到正式站点。</p>}<div class="tags">{tags.map(tag => <span>{tag}</span>)}</div><h1>{title}</h1><p class="detail-description">{description}</p><slot name="meta" /></header>
    <slot name="cover" />
    <div class="detail-grid"><div class="prose"><slot /></div>{headings.some(h => h.depth === 2) && <aside class="toc"><p class="eyebrow">ON THIS PAGE / 目录</p><nav aria-label="文章目录">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}</div>
    <div class="detail-end"><span>感谢阅读。Stay curious.</span><a class="text-link" href={`/${kind}/`}>继续探索 →</a></div>
  </article>
</Base>
