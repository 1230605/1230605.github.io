---
import { render } from 'astro:content';
import { articles, dateLabel } from '../../lib/content';
import Detail from '../../layouts/Detail.astro';
export async function getStaticPaths() {
  return (await articles()).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Detail title={entry.data.title} description={entry.data.description} tags={entry.data.tags} preview={entry.data.demo || entry.data.draft} kind="articles" headings={headings}><time slot="meta" class="detail-date" datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time><Content /></Detail>
