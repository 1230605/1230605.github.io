---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../lib/content';
const entries = await projects();
---
<Base title="项目 / Projects"><section class="wrap listing"><p class="eyebrow">SELECTED WORK / 精选项目</p><h1>想法的形状。<span>Projects.</span></h1><p class="listing-description">从一个问题出发，在实践中寻找答案。</p>{entries.length ? <div class="project-grid">{entries.map(project => <ProjectCard project={project} />)}</div> : <div class="listing-empty"><span class="empty-index">IDEA → REALITY</span><h2>下一个想法，即将成形。</h2><p>项目内容正在整理，稍后与你分享。</p><a class="text-link" href="/">返回首页 →</a></div>}</section></Base>
