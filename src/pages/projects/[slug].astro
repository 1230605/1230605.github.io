---
import { render } from 'astro:content';
import { projects } from '../../lib/content';
import Detail from '../../layouts/Detail.astro';
export async function getStaticPaths() {
  return (await projects()).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Detail title={entry.data.title} description={entry.data.description} tags={entry.data.tags} preview={entry.data.demo || entry.data.draft} kind="projects" headings={headings}><div slot="meta" class="contact-links">{entry.data.code && <a class="text-link" href={entry.data.code}>Source code ↗</a>}{entry.data.paper && <a class="text-link" href={entry.data.paper}>Read paper ↗</a>}</div><img slot="cover" class="detail-cover" src={entry.data.cover} alt={entry.data.coverAlt} width="1600" height="1000" /><Content /></Detail>
