---
import Base from '../../layouts/Base.astro';
import { research } from '../../lib/content';
const entries = await research();
---
<Base title="研究方向 / Research"><section class="wrap listing">
  <a class="back-link" href="/contents/">← 全站目录 / Index</a>
  <p class="eyebrow listing-kicker">QUESTIONS & METHODS / 研究方向</p>
  <h1>未完成的提问。<span>Research.</span></h1>
  <p class="listing-description">沿着问题的线索，留下方法、进展与仍待探索的可能。</p>
  {entries.length ? <div class="research-index">{entries.map((entry, i) => <a href={`/research/${entry.id}/`} class="research-entry"><span class="entry-number">{String(i + 1).padStart(2, '0')}</span><div><p class="eyebrow">{entry.data.english}</p><h2>{entry.data.title}</h2><p>{entry.data.description}</p>{(entry.data.demo || entry.data.draft) && <span class="demo-tag">{entry.data.demo ? '演示内容' : '草稿预览'}</span>}</div><span aria-hidden="true">↗</span></a>)}</div> : <div class="listing-empty"><span class="empty-index">QUESTIONS YET TO UNFOLD</span><h2>为下一个问题，留一页空间。</h2><p>研究方向将在整理完成后逐项更新。</p><a class="text-link" href="/contents/">浏览全站目录 →</a></div>}
</section></Base>
