---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { profile } from '../data/profile';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');
const { Content, headings } = await render(page);
const tocHeadings = [...headings, { depth: 2, slug: 'contact', text: '联系与交流' }];
---
<Base title="关于我 / About" description={page.data.description}>
  <article class="detail wrap">
    <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><a href="/contents/">全站目录</a><span>/</span><span aria-current="page">关于我</span></nav>
    <header class="detail-header"><p class="eyebrow">A LITTLE CONTEXT / ABOUT</p><h1>{page.data.title}</h1><p class="detail-description">{page.data.description}</p></header>
    <div class="detail-grid"><div class="prose"><Content /><h2 id="contact">联系与交流</h2>{profile.email || profile.github || profile.resume ? <div class="contact-links">{profile.email && <a href={`mailto:${profile.email}`}>Email ↗</a>}{profile.github && <a href={profile.github}>GitHub ↗</a>}{profile.resume && <a href={profile.resume}>简历 ↗</a>}</div> : <p>公开联系方式待补充。</p>}</div><TableOfContents headings={tocHeadings} /></div>
    <div class="detail-end"><a class="text-link" href="/contents/">全站目录 →</a></div>
  </article>
</Base>
