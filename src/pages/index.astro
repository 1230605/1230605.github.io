---
import Base from '../layouts/Base.astro';
import Study from '../components/Study.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { profile } from '../data/profile';
import { articles, projects } from '../lib/content';
const featured = (await projects()).slice(0, 2);
const latest = (await articles()).slice(0, 3);
---
<Base>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow hero-eyebrow">RESEARCH &amp; NOTES <span>研究与札记</span></p>
      <h1>{profile.headline || <>在思考与<br /><span>实践之间。</span></>}</h1>
      <p class="hero-english">{profile.englishHeadline || 'A practice of curiosity.'}</p>
      <p class="hero-description">{profile.bio || '观察、推敲，偶尔让思绪走远。\n在这里，记录研究的线索与实践的片段。'}</p>
      <div class="hero-actions"><a class="button" href="/projects/">探索项目 <span aria-hidden="true">↗</span></a><a class="text-link" href="/articles/">阅读文章 <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="hero-visual"><Study /></div>
    <div class="hero-bottom"><span>研究 · 构建 · 分享</span><a href="#research">向下探索 <span aria-hidden="true">↓</span></a><span>AN OPEN-ENDED JOURNEY</span></div>
  </section>
  <section id="research" class="research-section section-space">
    <div class="wrap" data-reveal><SectionHeading label="01 / RESEARCH" title="未完成的提问。" />
      {profile.research.length ? <div class="research-grid">{profile.research.map((item, i) => <article><span class="research-number">0{i + 1}</span><p class="eyebrow">{item.english}</p><h3>{item.title}</h3><p>{item.description}</p></article>)}</div> :
        <div class="research-placeholder"><div class="line-diagram" aria-hidden="true"><i></i><i></i><i></i><span>?</span></div><div><p class="eyebrow">ROOM FOR THE NEXT QUESTION</p><h3>下一次探索，从这里开始。</h3><p>研究方向将在这里更新。<br />为好问题留一点空间，也为新的可能。</p><span class="quiet-status">研究方向 · 待补充</span></div></div>}
    </div>
  </section>
  <section class="projects-section section-space"><div class="wrap" data-reveal>
    <SectionHeading label="02 / SELECTED PROJECTS" title="一些实践。" href="/projects/" link="所有项目" />
    {featured.length ? <div class="project-grid">{featured.map(project => <ProjectCard project={project} />)}</div> : <div class="project-empty"><div class="empty-grid-art" aria-hidden="true"><span></span><span></span><span></span></div><div><p class="eyebrow">WORK IN PROGRESS</p><h3>每个作品，<br />都是一次新的探索。</h3><p>项目正在整理，精彩即将呈现。</p><span class="quiet-status">项目内容 · 待补充</span></div></div>}
  </div></section>
  <section class="writing-section section-space wrap" data-reveal><SectionHeading label="03 / WRITING" title="纸上的思绪。" href="/articles/" link="所有文章" />
    {latest.length ? <div class="article-list">{latest.map(article => <ArticleRow article={article} />)}</div> : <div class="writing-empty"><span class="writing-symbol" aria-hidden="true">[ &nbsp; ]</span><div><h3>留给下一篇思考。</h3><p>技术笔记与研究随想，将在这里慢慢积累。</p></div><span class="eyebrow">NOTES TO COME</span></div>}
  </section>
  <section id="about" class="about-section"><div class="wrap about-grid" data-reveal><div><p class="eyebrow">04 / ABOUT</p><h2>不止于答案。<br /><span>始终保持好奇。</span></h2></div><div class="about-copy"><p>{profile.bio || '这里将介绍我的研究兴趣、技术经历，以及正在探索的问题。'}</p>{profile.name ? <p class="profile-name">{profile.name}</p> : <span class="quiet-status">个人介绍 · 待补充</span>}<div class="contact-links">{profile.email && <a class="text-link" href={`mailto:${profile.email}`}>联系我 ↗</a>}{profile.github && <a class="text-link" href={profile.github}>GitHub ↗</a>}{profile.resume && <a class="text-link" href={profile.resume}>查看简历 ↗</a>}</div></div></div></section>
</Base>
