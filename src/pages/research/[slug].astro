---
import { render } from 'astro:content';
import { research } from '../../lib/content';
import Detail from '../../layouts/Detail.astro';
export async function getStaticPaths() {
  return (await research()).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Detail title={entry.data.title} description={entry.data.description} tags={entry.data.tags} preview={entry.data.demo || entry.data.draft} kind="research" currentId={entry.id} headings={headings}><p slot="meta" class="eyebrow">{entry.data.english}</p><Content /></Detail>
